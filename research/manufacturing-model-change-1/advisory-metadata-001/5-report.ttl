@prefix e: <urn:manufacturing-review:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode e:packet ;
            sh:resultMessage "execution_unavailable" ;
            sh:resultPath e:execution_status ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
            sh:sourceShape [ sh:hasValue "completed" ;
                    sh:message "execution_unavailable" ;
                    sh:path e:execution_status ] ] .

