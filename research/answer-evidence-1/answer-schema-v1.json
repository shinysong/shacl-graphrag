{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound answer diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "answer",
    "claims",
    "limitations",
    "review_requests"
  ],
  "properties": {
    "status": {
      "enum": [
        "answered",
        "partial",
        "insufficient_evidence"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "kind",
          "value",
          "unit",
          "certainty",
          "citations"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "recorded",
              "derived"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "certainty": {
            "enum": [
              "asserted",
              "qualified"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chunk_id",
                "locator"
              ],
              "properties": {
                "chunk_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "reason",
          "evidence_ids"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
