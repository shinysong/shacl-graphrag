{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-answer atomic claim draft v1; proposed unmeasured model interface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "status",
    "claims",
    "limitations"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "answered",
        "partial",
        "insufficient_evidence"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "kind",
          "source_id",
          "field",
          "value",
          "unit"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "recorded",
              "derived"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
