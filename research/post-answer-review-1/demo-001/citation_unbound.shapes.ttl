owl:Class rdfs:subClassOf rdfs:Class .

owl:DatatypeProperty rdfs:subClassOf rdf:Property .

<urn:post-answer-review:shape/10> a sh:NodeShape ;
    sh:property [ sh:hasValue "1" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:post-answer-review:observed> ] ;
    sh:targetNode <urn:post-answer-review:check/10> .

