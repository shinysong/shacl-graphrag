@prefix ex: <urn:shacl-study:advisory:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport ;
    sh:conforms false ;
    sh:result [ a sh:ValidationResult ;
            sh:focusNode ex:result ;
            sh:resultMessage "missing_current_fingerprint" ;
            sh:resultPath ex:currentHash ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
            sh:sourceShape ex:CurrentRequired ],
        [ a sh:ValidationResult ;
            sh:focusNode ex:result ;
            sh:resultMessage "fingerprint_disagreement_review_scope" ;
            sh:resultPath ex:usedHash ;
            sh:resultSeverity sh:Violation ;
            sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
            sh:sourceShape ex:VersionAgreement ;
            sh:value "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ] .

