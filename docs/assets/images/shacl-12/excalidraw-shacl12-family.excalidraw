      "strokeColor": "#343a40",
      "textAlign": "middle"
    },
    {
      "id": "text_4",
      "type": "text",
      "x": 179,
      "y": 94.5,
      "text": "(단일 통합 명세 + 비규범 노트/비표준 확장)",
      "fontSize": 11.5,
