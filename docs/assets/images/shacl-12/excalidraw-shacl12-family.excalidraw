      "textAlign": "middle"
    },
    {
      "id": "text_7",
      "type": "text",
      "x": 179,
      "y": 170.5,
      "text": "Core 제약 + SPARQL 확장 단일 문서 통합",
      "fontSize": 11.5,
      "strokeColor": "#343a40",
      "textAlign": "middle"
    },
    {
      "id": "text_8",
      "type": "text",
      "x": 179,
      "y": 191,
      "text": "경량 엔진도 SPARQL 1.1 의존성 부담",
