ys:editor_property
		sh:path schema:editor ;
		rdfs:label "editor"@en ;
		rdfs:comment "An editor of a Creative Work"@en ;
		ys:fromProperty wdt:P98 ;
		sh:class schema:Person .

schema:editor	rdfs:label "editor"@en .

schema:editor	rdfs:comment "An editor of a Creative Work"@en .

ys:endDate_property
		sh:path schema:endDate ;
		rdfs:label "end Date"@en ;
		rdfs:comment "The date when an entity stopped existing"@en ;
		sh:maxCount 1 ;
