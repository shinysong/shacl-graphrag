yago:siConversion	rdfs:label "si Conversion"@en .

ys:numberOfSeasons_property
		sh:path schema:numberOfSeasons ;
		rdfs:label "number Of Seasons"@en ;
		rdfs:comment "The number of seasons in a TV Series"@en ;
		sh:maxCount 1 ;
		ys:fromProperty wdt:P2437 ;
		sh:datatype xsd:integer .

schema:numberOfSeasons	rdfs:label "number Of Seasons"@en .

schema:numberOfSeasons	rdfs:comment "The number of seasons in a TV Series"@en .

ys:lyricist_property
		sh:path schema:lyricist ;
		rdfs:label "lyricist"@en ;
		rdfs:comment "The lyricist of a MusicComposition"@en ;
		ys:fromProperty wdt:P676 ;
		sh:or ([ sh:class schema:Organization ][ sh:class schema:Person]).

schema:lyricist	rdfs:label "lyricist"@en .

schema:lyricist	rdfs:comment "The lyricist of a MusicComposition"@en .

ys:iswcCode_property
		sh:path yago:iswcCode ;
		rdfs:label "iswc Code"@en ;
		sh:maxCount 1 ;
		sh:pattern "^T-[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]$" ;
		ys:fromProperty wdt:P1827 ;
