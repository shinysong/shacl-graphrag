@prefix ex: <https://example.org/gleif-pilot/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Pilot evidence contract, not a complete implementation of GLEIF DQC rules.
ex:EntityShape a sh:NodeShape ;
    sh:targetClass ex:Entity ;
    sh:property [ sh:path ex:lei ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[A-Z0-9]{18}[0-9]{2}$" ] ;
    sh:property [ sh:path ex:legalName ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 1 ] .

ex:QueryShape a sh:NodeShape ;
    sh:targetClass ex:QuerySubject ;
    sh:property [ sh:path ex:directParent ; sh:maxCount 1 ; sh:class ex:Entity ] ;
    sh:property [ sh:path ex:exceptionReason ; sh:maxCount 1 ;
                  sh:in ("NO_LEI" "NATURAL_PERSONS" "NON_CONSOLIDATING" "NO_KNOWN_PERSON" "NON_PUBLIC") ] ;
    sh:xone (
      [ sh:property [ sh:path ex:directParent ; sh:minCount 1 ] ;
        sh:property [ sh:path ex:exceptionReason ; sh:maxCount 0 ] ]
      [ sh:property [ sh:path ex:exceptionReason ; sh:minCount 1 ] ;
        sh:property [ sh:path ex:directParent ; sh:maxCount 0 ] ]
    ) .
