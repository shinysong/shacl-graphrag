          "filter": {
            "orders.status": "confirmed"
          },
          "group_by": [
            "orders.customer_id"
          ],
          "aggregate": {
            "op": "sum_product",
            "fields": [
              "order_items.quantity",
              "order_items.unit_price_cents"
            ],
            "units": "cents"
          }
        },
        "reason": "Current SUM accepts one root field only. Summing unit_price_cents or quantity alone changes the fixed compound question. Tax and freight are excluded by source policy."
