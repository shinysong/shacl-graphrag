# Copy to .env and fill in. Never commit .env.

# --- LLM via OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model slug on OpenRouter (change per experiment condition)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter rankings / app attribution
OPENROUTER_HTTP_REFERER=https://github.com/shinysong/shacl-graphrag
OPENROUTER_X_TITLE=shacl-graphrag

# --- Graph stores (fill when services are up) ---
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=shacl-graphrag
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# --- Paths ---
DATA_DIR=./data
RESULTS_DIR=./results
LOG_DIR=./logs
